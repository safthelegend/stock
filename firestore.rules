rules_version = '2';

// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
// Kept in the repo so changes are reviewed like code. The limits here must
// match the ones in assets/portal.js (buildFields).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is this? ----------
    function signedIn() { return request.auth != null; }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function role() { return exists(roleDoc()) ? get(roleDoc()).data.role : null; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // A verified account: one an admin has given a role.
    function isMember() { return signedIn() && role() in ['member', 'admin']; }

    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- roles/{uid}: { role: "member" | "admin", verifiedBy?, verifiedAt? } ----------
    // Having a role is what makes an account verified. Admins verify new
    // members from the portal's Review tab (assets/admin.js), which can only
    // ever grant "member". Admin rights are still given by hand in the
    // console, so nobody can make themselves or anyone else an admin.
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.verifiedBy == request.auth.token.email
        && request.resource.data.verifiedAt == request.time;
      allow update, delete: if false;
    }

    // ---------- members/{uid}: { name, email, createdAt } ----------
    // Saved by each person the first time they open the portal, so admins can
    // see who is waiting to be verified. It doesn't make anyone a member;
    // roles/{uid} does.
    match /members/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && str(request.resource.data.name, 200)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- public contact form ----------
    match /contactSubmissions/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'org', 'message', 'createdAt'])
        && str(request.resource.data.name, 200) && request.resource.data.name.size() > 0
        && str(request.resource.data.email, 320) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.role, 100)
        && str(request.resource.data.org, 200)
        && str(request.resource.data.message, 5000)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- deliveries ----------
    function validDelivery(d) {
      return d.keys().hasOnly(['memberUid', 'memberEmail', 'date', 'boxId', 'fromSchool', 'toSite',
                               'weightLbs', 'items', 'notes', 'temps', 'hasPhoto', 'photoPublic', 'status',
                               'reviewNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.boxId, 40)
        && str(d.fromSchool, 120) && d.fromSchool.size() > 0
        && str(d.toSite, 120) && d.toSite.size() > 0
        && d.weightLbs is number && d.weightLbs > 0 && d.weightLbs <= 500
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && str(d.notes, 2000)
        && d.temps is list && d.temps.size() <= 500
        && d.hasPhoto is bool
        && (!('photoPublic' in d) || d.photoPublic is bool)
        && d.status in ['pending', 'accepted', 'rejected']
        && str(d.reviewNote, 1000)
        && (!('reviewedBy' in d) || str(d.reviewedBy, 320));
    }

    match /deliveries/{id} {
      // Anyone signed in logs their own, always as pending, with no review
      // fields. An unverified account's deliveries wait in Review, off the
      // public log, until an admin verifies it.
      allow create: if signedIn()
        && validDelivery(request.resource.data)
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.memberEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewNote == ''
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // People see their own; admins see everything.
      allow read: if isAdmin() || (signedIn() && resource.data.memberUid == request.auth.uid);

      // Only admins change anything, and never who logged it or when.
      allow update: if isAdmin()
        && validDelivery(request.resource.data)
        && request.resource.data.memberUid == resource.data.memberUid
        && request.resource.data.memberEmail == resource.data.memberEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hasPhoto == resource.data.hasPhoto
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // ---------- publicLog/{deliveryId}: the public delivery log (log.html) ----------
    // A trimmed copy of each delivery that anyone can read: date, weight, how
    // many kinds of food, status, the school the food came from, that
    // school's borough (region), the community fridge it went to (site), and
    // whether it has a public photo (photo, see publicPhotos). All but the
    // first four are optional; older entries don't have them. Nothing that
    // says who delivered it, or what the notes say.
    // Rejected deliveries are removed from it. Admins' portals keep it in step
    // with deliveries (assets/admin.js, syncPublicLog).
    function validPublic(d) {
      return d.keys().hasOnly(['date', 'weightLbs', 'foods', 'status', 'region', 'school', 'site', 'photo'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.weightLbs is number && d.weightLbs > 0 && d.weightLbs <= 500
        && d.foods is int && d.foods >= 0 && d.foods <= 50
        && d.status in ['pending', 'accepted']
        && (!('region' in d) || d.region in ['Manhattan', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island'])
        && (!('school' in d) || str(d.school, 120))
        && (!('site' in d) || str(d.site, 120))
        && (!('photo' in d) || d.photo is bool);
    }
    function deliveryOf(id) { return get(/databases/$(database)/documents/deliveries/$(id)).data; }
    // An admin's entry has to say exactly what its delivery says: the same
    // date, weight, number of foods, status, school and fridge, and a photo
    // only if that delivery's public photo is really there.
    function matchesDelivery(id, e) {
      let d = deliveryOf(id);
      return e.date == d.date && e.weightLbs == d.weightLbs && e.foods == d.items.size() && e.status == d.status
        && (!('school' in e) || e.school == d.fromSchool)
        && (!('site' in e) || e.site == d.toSite)
        && (!('photo' in e) || e.photo == false || exists(/databases/$(database)/documents/publicPhotos/$(id)));
    }

    match /publicLog/{id} {
      allow read: if true;
      // A verified member adds the entry right after saving their new
      // delivery, and it has to match that delivery exactly. Unverified
      // accounts can't: their deliveries stay off until an admin verifies them.
      allow create: if isMember()
        && validPublic(request.resource.data)
        && deliveryOf(id).memberUid == request.auth.uid
        && deliveryOf(id).status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.date == deliveryOf(id).date
        && request.resource.data.weightLbs == deliveryOf(id).weightLbs
        && request.resource.data.foods == deliveryOf(id).items.size()
        && (!('school' in request.resource.data) || request.resource.data.school == deliveryOf(id).fromSchool)
        && (!('site' in request.resource.data) || request.resource.data.site == deliveryOf(id).toSite)
        && !('photo' in request.resource.data);
      allow create, update: if isAdmin() && validPublic(request.resource.data) && matchesDelivery(id, request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- publicPhotos/{deliveryId}: { dataUrl } ----------
    // The public copy of a delivery's photo, shown on the delivery log. Only
    // an admin's portal writes it, once the delivery is accepted and unless
    // the admin chose to keep that photo private (deliveries.photoPublic).
    // It has to be exactly the photo attached to that same delivery.
    match /publicPhotos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['dataUrl'])
        && request.resource.data.dataUrl == get(/databases/$(database)/documents/deliveryPhotos/$(id)).data.dataUrl
        && deliveryOf(id).status == 'accepted'
        && deliveryOf(id).get('photoPublic', true) != false;
      allow delete: if isAdmin();
    }

    // ---------- deliveryPhotos/{deliveryId}: { memberUid, dataUrl } ----------
    match /deliveryPhotos/{id} {
      // getAfter() looks at the delivery as it will be once this batch lands,
      // so a photo can only be attached to your own delivery, in the same write.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUid', 'dataUrl'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && getAfter(/databases/$(database)/documents/deliveries/$(id)).data.memberUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.memberUid == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}