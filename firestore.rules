rules_version = '2';

// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
// Kept in the repo so changes are reviewed like code. The limits here must
// match the ones in assets/portal.js (buildFields).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is this? ----------
    function signedIn() { return request.auth != null; }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function role() { return exists(roleDoc()) ? get(roleDoc()).data.role : null; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isMember() { return signedIn() && role() in ['member', 'admin']; }
    function isSensor() { return signedIn() && role() == 'sensor'; }

    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- roles/{uid}: { role: "member" | "admin" | "sensor" } ----------
    // Created by hand in the console only. Nobody can promote themselves.
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- public contact form ----------
    match /contactSubmissions/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'org', 'message', 'createdAt'])
        && str(request.resource.data.name, 200) && request.resource.data.name.size() > 0
        && str(request.resource.data.email, 320) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.role, 100)
        && str(request.resource.data.org, 200)
        && str(request.resource.data.message, 5000)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- deliveries ----------
    function validDelivery(d) {
      return d.keys().hasOnly(['memberUid', 'memberEmail', 'date', 'boxId', 'fromSchool', 'toSite',
                               'weightLbs', 'items', 'notes', 'crew', 'temps', 'tempsPublic', 'hasPhoto', 'status',
                               'reviewNote', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.boxId, 40)
        && str(d.fromSchool, 120) && d.fromSchool.size() > 0
        && str(d.toSite, 120) && d.toSite.size() > 0
        && d.weightLbs is number && d.weightLbs > 0 && d.weightLbs <= 500
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && str(d.notes, 2000)
        && (!('crew' in d) || str(d.crew, 1000))
        && d.temps is list && d.temps.size() <= 500
        && (!('tempsPublic' in d) || d.tempsPublic is bool)
        && d.hasPhoto is bool
        && d.status in ['pending', 'accepted', 'rejected']
        && str(d.reviewNote, 1000)
        && (!('reviewedBy' in d) || str(d.reviewedBy, 320));
    }

    match /deliveries/{id} {
      // Members log their own, always as pending, with no review fields.
      allow create: if isMember()
        && validDelivery(request.resource.data)
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.memberEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewNote == ''
        && !('tempsPublic' in request.resource.data)
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Members see their own; admins see everything.
      allow read: if isAdmin() || (isMember() && resource.data.memberUid == request.auth.uid);

      // Only admins change anything, and never who logged it, when, or the
      // temperature readings the sensor recorded. Admins can choose whether
      // the readings show on the public log (tempsPublic).
      allow update: if isAdmin()
        && validDelivery(request.resource.data)
        && request.resource.data.memberUid == resource.data.memberUid
        && request.resource.data.memberEmail == resource.data.memberEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hasPhoto == resource.data.hasPhoto
        && request.resource.data.temps == resource.data.temps
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // ---------- publicLog/{deliveryId}: the public delivery log (log.html) ----------
    // A trimmed copy of each delivery that anyone can read: date, weight, how
    // many kinds of food, and status, plus the temperature readings when an
    // admin has chosen to publish them (deliveries.tempsPublic). Nothing that says who delivered it, from
    // which school, to which site, or what the notes and photo say.
    // Rejected deliveries are removed from it. Admins' portals keep it in step
    // with deliveries (assets/admin.js, syncPublicLog).
    function validPublic(d) {
      return d.keys().hasOnly(['date', 'weightLbs', 'foods', 'status', 'temps'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.weightLbs is number && d.weightLbs > 0 && d.weightLbs <= 500
        && d.foods is int && d.foods >= 0 && d.foods <= 50
        && d.status in ['pending', 'accepted']
        && (!('temps' in d) || (d.temps is list && d.temps.size() <= 500));
    }
    function deliveryOf(id) { return get(/databases/$(database)/documents/deliveries/$(id)).data; }

    match /publicLog/{id} {
      allow read: if true;
      // A member adds the entry right after saving their new delivery, and it
      // has to match that delivery exactly.
      allow create: if isMember()
        && validPublic(request.resource.data)
        && deliveryOf(id).memberUid == request.auth.uid
        && deliveryOf(id).status == 'pending'
        && request.resource.data.status == 'pending'
        && !('temps' in request.resource.data)
        && request.resource.data.date == deliveryOf(id).date
        && request.resource.data.weightLbs == deliveryOf(id).weightLbs
        && request.resource.data.foods == deliveryOf(id).items.size();
      allow create, update: if isAdmin() && validPublic(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- deliveryPhotos/{deliveryId}: { memberUid, dataUrl } ----------
    match /deliveryPhotos/{id} {
      // getAfter() looks at the delivery as it will be once this batch lands,
      // so a photo can only be attached to your own delivery, in the same write.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['memberUid', 'dataUrl'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && getAfter(/databases/$(database)/documents/deliveries/$(id)).data.memberUid == request.auth.uid;
      allow read: if isAdmin() || (isMember() && resource.data.memberUid == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- sensors/{uid}: { name } ----------
    // One per box sensor. {uid} is the sensor's own Firebase account, which
    // has role "sensor" in roles/. Created by hand in the console, like roles.
    match /sensors/{uid} {
      allow read: if isMember();
      allow write: if false;

      // sensors/{uid}/readings/{seconds}: { c, at }
      // The ESP32 adds one a minute (temperature_sensor/). Only that sensor
      // can add to its own list, and nobody can change or remove a reading.
      // The website copies the ones between Start and Stop into the delivery.
      match /readings/{rid} {
        allow read: if isMember();
        allow create: if isSensor() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['c', 'at'])
          && request.resource.data.c is number
          && request.resource.data.c > -55 && request.resource.data.c < 125
          && request.resource.data.at is timestamp
          && request.resource.data.at < request.time + duration.value(10, 'm');
        allow update, delete: if false;
      }
    }
  }
}
